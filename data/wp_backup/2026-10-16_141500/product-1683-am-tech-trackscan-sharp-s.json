-size:17px;line-height:1.7;color:#e8e8e8}</p>\r\n<p>    .tss-chart-grid{<br />\r\n      display:grid;<br />\r\n      grid-template-columns:repeat(3,1fr);<br />\r\n      gap:22px;<br />\r\n    }</p>\r\n<p>    .tss-chart-card{<br />\r\n      padding:28px;<br />\r\n      border-radius:28px;<br />\r\n      background:rgba(255,255,255,.08);<br />\r\n      border:1px solid rgba(255,255,255,.14);<br />\r\n    }</p>\r\n<p>    .tss-chart-card h4{margin:0 0 22px;font-size:21px;color:#fff}<br />\r\n    .tss-big-value{font-size:42px;line-height:1;font-weight:800;color:#ff9a32;margin-bottom:10px}<br />\r\n    .tss-chart-card p{margin:12px 0 0;font-size:15px;line-height:1.55;color:#eee}</p>\r\n<p>    .tss-progress{<br />\r\n      height:18px;<br />\r\n      border-radius:30px;<br />\r\n      background:rgba(255,255,255,.14);<br />\r\n      overflow:hidden;<br />\r\n      margin:22px 0 16px;<br />\r\n    }</p>\r\n<p>    .tss-progress span{<br />\r\n      display:block;<br />\r\n      height:100%;<br />\r\n      border-radius:30px;<br />\r\n      background:linear-gradient(90deg,#ff7a00,#ffbd7a);<br />\r\n    }</p>\r\n<p>    .tss-radial{<br />\r\n      width:160px;<br />\r\n      height:160px;<br />\r\n      margin:0 auto 18px;<br />\r\n      border-radius:50%;<br />\r\n      background:radial-gradient(circle at center,#222 57%,transparent 58%),conic-gradient(#ff7a00 86%,rgba(255,255,255,.16) 0);<br />\r\n      display:flex;<br />\r\n      align-items:center;<br />\r\n      justify-content:center;<br />\r\n    }</p>\r\n<p>    .tss-radial span{font-size:30px;font-weight:800;color:#fff}</p>\r\n<p>    .tss-bars{<br />\r\n      height:180px;<br />\r\n      display:flex;<br />\r\n      align-items:flex-end;<br />\r\n      gap:16px;<br />\r\n      border-bottom:1px solid rgba(255,255,255,.18);<br />\r\n      padding-top:12px;<br />\r\n    }</p>\r\n<p>    .tss-bars div{<br />\r\n      flex:1;<br />\r\n      height:100%;<br />\r\n      display:flex;<br />\r\n      flex-direction:column;<br />\r\n      justify-content:flex-end;<br />\r\n      align-items:center;<br />\r\n      gap:9px;<br />\r\n      font-size:13px;<br />\r\n      color:#eee;<br />\r\n      text-align:center;<br />\r\n    }</p>\r\n<p>    .tss-bars i{<br />\r\n      width:100%;<br />\r\n      max-width:48px;<br />\r\n      display:block;<br />\r\n      border-radius:14px 14px 0 0;<br />\r\n      background:linear-gradient(180deg,#ff7a00,#ffbd7a);<br />\r\n      box-shadow:0 0 18px rgba(255,122,0,.25);<br />\r\n    }</p>\r\n<p>    .tss-cards{<br />\r\n      display:grid;<br />\r\n      grid-template-columns:repeat(3,1fr);<br />\r\n      gap:22px;<br />\r\n      margin-top:34px;<br />\r\n    }</p>\r\n<p>    .tss-card{<br />\r\n      padding:30px;<br />\r\n      border-radius:28px;<br />\r\n      background:#fff;<br />\r\n      border:1px solid #ededed;<br />\r\n      box-shadow:0 14px 35px rgba(0,0,0,.05);<br />\r\n    }</p>\r\n<p>    .tss-card-number{<br />\r\n      width:50px;<br />\r\n      height:50px;<br />\r\n      border-radius:50%;<br />\r\n      background:#ff7a00;<br />\r\n      color:#fff;<br />\r\n      display:flex;<br />\r\n      align-items:center;<br />\r\n      justify-content:center;<br />\r\n      font-weight:800;<br />\r\n      margin-bottom:18px;<br />\r\n    }</p>\r\n<p>    .tss-card strong{display:block;margin-bottom:10px;font-size:22px;color:#111}<br />\r\n    .tss-card p{margin:0;font-size:15px;line-height:1.7;color:#555}</p>\r\n<p>    .tss-dark{<br />\r\n      margin-top:68px;<br />\r\n      padding:44px;<br />\r\n      border-radius:34px;<br />\r\n      background:#fff;<br />\r\n      border:1px solid #ededed;<br />\r\n      box-shadow:0 20px 55px rgba(0,0,0,.08);<br />\r\n    }</p>\r\n<p>    .tss-dark h3{margin:0 0 18px;font-size:34px;color:#111}<br />\r\n    .tss-dark p{margin:0;font-size:17px;line-height:1.8;color:#444}</p>\r\n<p>    @media(max-width:980px){<br />\r\n      .tss-hero,.tss-chart-grid,.tss-cards{grid-template-columns:1fr}<br />\r\n      .tss-container{padding:42px 16px}<br />\r\n      .tss-title{font-size:38px}<br />\r\n      .tss-visual{min-height:420px}<br />\r\n      .tss-core{width:290px;padding:28px}<br />\r\n      .tss-core-value{font-size:42px}<br />\r\n      .tss-premium-metrics,.tss-dark{padding:28px}<br />\r\n    }<br />\r\n  </style></p>\r\n\r\n<div class=\"tss-container\">\r\n<div class=\"tss-hero\">\r\n<div class=\"tss-hero-text\">\r\n<h2 class=\"tss-title\">TrackScan Sharp S</h2>\r\n<p class=\"tss-lead\">Оптическая система 3D-сканирования TrackScan Sharp S, оснащенная\r\n<span class=\"tss-orange\">25-мегапиксельными промышленными камерами</span>\r\nи встроенными процессорами для пограничных вычислений, предназначена для высокоскоростного измерения крупногабаритных деталей на больших расстояниях.</p>\r\n<p class=\"tss-lead\">Система обеспечивает расстояние отслеживания до <span class=\"tss-orange\">8,5 метров</span>,\r\nизмерительный объем до <span class=\"tss-orange\">135 м³</span>\r\nи скорость до <span class=\"tss-orange\">4,86 млн измерений/с</span>.</p>\r\n\r\n</div>\r\n<div class=\"tss-visual\">\r\n<div class=\"tss-grid\"></div>\r\n<div class=\"tss-core\"><span class=\"tss-core-label\">Производительность системы</span>\r\n<span class=\"tss-core-value\">4.86M</span>\r\n<div class=\"tss-core-chart\"><i style=\"height: 38%;\"></i>\r\n<i style=\"height: 52%;\"></i>\r\n<i style=\"height: 74%;\"></i>\r\n<i style=\"height: 88%;\"></i>\r\n<i style=\"height: 100%;\"></i></div>\r\n<div class=\"tss-core-bottom\">измерений в секунду\r\nдля промышленной метрологии</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"tss-image-card\">\r\n<p class=\"mod-reset\"><img src=\"/upload/editor_images/1725885360-mceu_49803362711725885360146.jpg\" alt=\"TrackScan Sharp S\" height=\"600\"></p>\r\n\r\n</div>\r\n<div class=\"tss-premium-metrics\">\r\n<h3>Ключевые параметры системы</h3>\r\nВизуальные показатели производительности TrackScan Sharp S для задач крупногабаритного промышленного контроля.\r\n<div class=\"tss-chart-grid\">\r\n<div class=\"tss-chart-card\">\r\n<h4>Дальность отслеживания</h4>\r\n<div class=\"tss-radial\">8.5 м</div>\r\nСтабильное отслеживание на больших расстояниях без потери точности.\r\n\r\n</div>\r\n<div class=\"tss-chart-card\">\r\n<h4>Измерительный объем</h4>\r\n<div class=\"tss-bars\">\r\n<div>Точный<i style=\"height: 58%;\"></i><b>135 м³</b></div>\r\n<div>Расширенный<i style=\"height: 100%;\"></i><b>233 м³</b></div>\r\n</div>\r\nРабота с крупными объектами без частого перемещения оборудования.\r\n\r\n</div>\r\n<div class=\"tss-chart-card\">\r\n<h4>Скорость измерений</h4>\r\n<div class=\"tss-progress\"></div>\r\n<div class=\"tss-big-value\">4.86M</div>\r\nДо 4,86 млн измерений в секунду для ускоренного контроля деталей.\r\n\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"tss-section\">\r\n<h3 class=\"tss-section-title\">Отслеживание на большие расстояния и объемы</h3>\r\n<p class=\"tss-section-text\">TrackScan Sharp S использует динамический адаптивный алгоритм отслеживания и расширенную глубину резкости, что позволяет стабильно работать на расстоянии до 8,5 метров.</p>\r\n<p class=\"tss-section-text\">Высокоточный измерительный объем 135 м³ и расширенный диапазон сканирования 233 м³ обеспечивают работу без частого перемещения оборудования.</p>\r\n\r\n<div class=\"tss-cards\">\r\n<div class=\"tss-card\">\r\n<div class=\"tss-card-number\">01</div>\r\n<strong>Дальность отслеживания</strong>\r\n\r\nСтабильная работа на расстоянии до 8,5 метров для измерения крупных объектов.\r\n\r\n</div>\r\n<div class=\"tss-card\">\r\n<div class=\"tss-card-number\">02</div>\r\n<strong>Высокая скорость</strong>\r\n\r\nПроизводительность до 4,86 млн измерений в секунду для ускорения контроля.\r\n\r\n</div>\r\n<div class=\"tss-card\">\r\n<div class=\"tss-card-number\">03</div>\r\n<strong>Большой объем измерений</strong>\r\n\r\nИзмерительный объем до 135 м³ для контроля крупногабаритных изделий.\r\n\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"tss-dark\">\r\n<h3>Беспроводная работа и промышленная стабильность</h3>\r\nОборудование поддерживает беспроводную работу и интеллектуальную обработку данных, обеспечивая свободу перемещения оператора и стабильную точность измерений. Все оборудование доступно на условиях лизинга с возможностью подбора оптимальной финансовой схемы и сопровождения внедрения.\r\n\r\n</div>\r\n</div>\r\n</section>",
 "short_description": "Система TrackScan-Sharp 49 обеспечивает высокоточное 3D-сканирование без маркеров.\r\n\r\nСистема TrackScan-Sharp 49 помогает в решении задач по обратному проектированию, контролю геометрии (качества), создания новых продуктов и т.д",
