:1.6;<br />      color:#ececec;<br />    }</p>\r\n<p>    .nc-infographic{<br />      display:grid;<br />      grid-template-columns:repeat(4,1fr);<br />      gap:22px;<br />      margin:58px 0;<br />    }</p>\r\n<p>    .nc-chart{<br />      background:#fff;<br />      border:1px solid #ededed;<br />      border-radius:28px;<br />      padding:28px;<br />      box-shadow:0 18px 45px rgba(0,0,0,.07);<br />      min-height:310px;<br />    }</p>\r\n<p>    .nc-chart h3{<br />      margin:0 0 18px;<br />      font-size:21px;<br />      color:#111;<br />    }</p>\r\n<p>    .nc-chart p{<br />      margin:14px 0 0;<br />      font-size:15px;<br />      line-height:1.6;<br />      color:#444;<br />    }</p>\r\n<p>    .nc-circle{<br />      width:170px;<br />      height:170px;<br />      margin:10px auto 18px;<br />      border-radius:50%;<br />      background:<br />        radial-gradient(circle at center,#fff 58%,transparent 59%),<br />        conic-gradient(#ff7a00 92%,#f0f0f0 0);<br />      display:flex;<br />      align-items:center;<br />      justify-content:center;<br />    }</p>\r\n<p>    .nc-circle span{<br />      font-size:22px;<br />      font-weight:800;<br />      color:#111;<br />    }</p>\r\n<p>    .nc-bar-bg{<br />      height:18px;<br />      margin:24px 0 16px;<br />      border-radius:30px;<br />      overflow:hidden;<br />      background:#f0f0f0;<br />    }</p>\r\n<p>    .nc-bar{<br />      width:100%;<br />      height:100%;<br />      border-radius:30px;<br />      background:linear-gradient(90deg,#ff7a00,#ffb15c);<br />    }</p>\r\n<p>    .nc-value{<br />      font-size:30px;<br />      font-weight:800;<br />      color:#ff7a00;<br />    }</p>\r\n<p>    .nc-columns{<br />      height:210px;<br />      display:flex;<br />      align-items:flex-end;<br />      gap:14px;<br />      border-bottom:1px solid #ddd;<br />      margin-top:22px;<br />    }</p>\r\n<p>    .nc-columns div{<br />      flex:1;<br />      display:flex;<br />      flex-direction:column;<br />      align-items:center;<br />      gap:8px;<br />      text-align:center;<br />      font-size:12px;<br />      color:#555;<br />    }</p>\r\n<p>    .nc-columns i{<br />      width:100%;<br />      max-width:42px;<br />      display:block;<br />      border-radius:12px 12px 0 0;<br />      background:linear-gradient(180deg,#ff7a00,#ffb15c);<br />    }</p>\r\n<p>    .nc-section{margin-top:64px}</p>\r\n<p>    .nc-section h3{<br />      margin:0 0 18px;<br />      font-size:34px;<br />      line-height:1.2;<br />      color:#111;<br />    }</p>\r\n<p>    .nc-cards{<br />      display:grid;<br />      grid-template-columns:repeat(2,1fr);<br />      gap:22px;<br />      margin-top:34px;<br />    }</p>\r\n<p>    .nc-card{<br />      padding:30px;<br />      border-radius:28px;<br />      background:#fafafa;<br />      border:1px solid #ededed;<br />      box-shadow:0 14px 35px rgba(0,0,0,.05);<br />    }</p>\r\n<p>    .nc-card-number{<br />      width:48px;<br />      height:48px;<br />      border-radius:50%;<br />      background:#ff7a00;<br />      color:#fff;<br />      display:flex;<br />      align-items:center;<br />      justify-content:center;<br />      font-weight:800;<br />      margin-bottom:18px;<br />    }</p>\r\n<p>    .nc-card strong{<br />      display:block;<br />      margin-bottom:10px;<br />      font-size:22px;<br />      color:#111;<br />    }</p>\r\n<p>    .nc-card p{<br />      margin:0;<br />      font-size:15px;<br />      line-height:1.7;<br />      color:#444;<br />    }</p>\r\n<p>    .nc-dark{<br />      margin-top:64px;<br />      padding:44px;<br />      border-radius:34px;<br />      background:linear-gradient(135deg,#111,#292929);<br />      box-shadow:0 24px 70px rgba(0,0,0,.18);<br />      color:#fff;<br />    }</p>\r\n<p>    .nc-dark h3{<br />      margin:0 0 18px;<br />      font-size:34px;<br />      color:#fff;<br />    }</p>\r\n<p>    .nc-dark p{<br />      margin:0;<br />      font-size:17px;<br />      line-height:1.8;<br />      color:#ececec;<br />    }</p>\r\n<p>    @media(max-width:980px){<br />      .nc-hero,<br />      .nc-infographic,<br />      .nc-cards{<br />        grid-template-columns:1fr;<br />      }</p>\r\n<p>      .nc-container{padding:42px 16px}<br />      .nc-title{font-size:38px}<br />      .nc-hero-visual{min-height:430px}</p>\r\n<p>      .nc-core{<br />        width:290px;<br />        padding:28px;<br />      }</p>\r\n<p>      .nc-core-value{font-size:42px}</p>\r\n<p>      .nc-rings{<br />        width:320px;<br />        height:320px;<br />      }<br />    }<br />  </style></p>\r\n\r\n<div class=\"nc-container\">\r\n<div class=\"nc-hero\">\r\n<div class=\"nc-hero-text\">\r\n<h2 class=\"nc-title\">NimbleTrack C+ —\r\n<strong>беспроводная система 3D-сканирования нового поколения</strong></h2>\r\n<p class=\"nc-lead\"><strong>NimbleTrack C+</strong> — высокотехнологичная система 3D-сканирования для прецизионных измерений средних и крупногабаритных объектов.</p>\r\n<p class=\"nc-lead\">Система построена на базе проверенной оптической платформы и оснащена инновационной лазерной матрицей, обеспечивающей высокую плотность данных, исключительную скорость сканирования и промышленную точность.</p>\r\n<p class=\"nc-lead\">NimbleTrack C+ устанавливает новый стандарт для метрологических задач в области контроля качества и обратного проектирования.</p>\r\n\r\n</div>\r\n<div class=\"nc-hero-visual\">\r\n<div class=\"nc-grid\"></div>\r\n<div class=\"nc-rings\"></div>\r\n<div class=\"nc-core\"><span class=\"nc-core-label\">Лазерная матрица</span>\r\n<span class=\"nc-core-value\">54 линии</span>\r\n<div class=\"nc-laser-graph\">\r\n<div class=\"nc-laser-line nc-line-1\"></div>\r\n<div class=\"nc-laser-line nc-line-2\"></div>\r\n<div class=\"nc-laser-line nc-line-3\"></div>\r\n<div class=\"nc-laser-line nc-line-4\"></div>\r\n<div class=\"nc-laser-line nc-line-5\"></div>\r\n</div>\r\n<div class=\"nc-core-bottom\">Плотное покрытие поверхности\r\nи высокодетализированное сканирование</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"nc-infographic\">\r\n<div class=\"nc-chart\">\r\n<h3>Скорость сканирования</h3>\r\n<div class=\"nc-bar-bg\">\r\n<div class=\"nc-bar\"></div>\r\n</div>\r\n<div class=\"nc-value\">6 630 000</div>\r\nточек в секунду для ускоренной оцифровки крупных объектов.\r\n\r\n</div>\r\n<div class=\"nc-chart\">\r\n<h3>Лазерная матрица</h3>\r\n<div class=\"nc-circle\">54</div>\r\nсиних пересекающихся лазерных линий для плотного покрытия поверхности.\r\n\r\n</div>\r\n<div class=\"nc-chart\">\r\n<h3>Поле зрения</h3>\r\n<div class=\"nc-columns\">\r\n<div>500 мм<i style=\"height: 84%;\"></i></div>\r\n<div>600 мм<i style=\"height: 100%;\"></i></div>\r\n</div>\r\nУвеличенная зона сканирования для объектов среднего и крупного размера.\r\n\r\n</div>\r\n<div class=\"nc-chart\">\r\n<h3>Объемная точность</h3>\r\n<div class=\"nc-circle\">0,032</div>\r\nВысокая стабильность измерений в соответствии со строгими промышленными требованиями.\r\n\r\n</div>\r\n</div>\r\n<div class=\"nc-section\">\r\n<h3>Ключевые преимущества NimbleTrack C+</h3>\r\n<div class=\"nc-cards\">\r\n<div class=\"nc-card\">\r\n<div class=\"nc-card-number\">01</div>\r\n<strong>Лазерная матрица повышенной плотности</strong>\r\n\r\n54 синих пересекающихся лазерных линии обеспечивают детализированное покрытие поверхности и быстрое захватывание сложной геометрии.\r\n\r\n</div>\r\n<div class=\"nc-card\">\r\n<div class=\"nc-card-number\">02</div>\r\n<strong>Высокая скорость и производительность</strong>\r\n\r\nСкорость до 6 630 000 точек в секунду позволяет значительно сократить время оцифровки крупных объектов.\r\n\r\n</div>\r\n<div class=\"nc-card\">\r\n<div class=\"nc-card-number\">03</div>\r\n<strong>Расширенное поле зрения</strong>\r\n\r\nПоле зрения 500 × 600 мм обеспечивает эффективную работу с крупными деталями без частого перемещения трекера.\r\n\r\n</div>\r\n<div class=\"nc-card\">\r\n<div class=\"nc-card-number\">04</div>\r\n<strong>Промышленная точность</strong>\r\n\r\nСтабильная платформа трекера гарантирует высокую точность измерений для метрологических задач промышленного уровня.\r\n\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"nc-dark\">\r\n<h3>Создан для промышленного контроля и реверс-инжиниринга</h3>\r\nNimbleTrack C+ идеально подходит для задач в автомобилестроении, аэрокосмической отрасли, энергетическом машиностроении и производстве оснастки, где критически важны скорость, детализация и надежность измерений.\r\n\r\n</div>\r\n</div>\r\n</section>",
 "short_description": "<span style=\"font-family: var(--ui-font-family-primary, var(--ui-font-family-helvetica));\">Система NimbleTrack-C+ обеспечивает высокоточное 3D-сканирование без маркеров. </span>\r\n\r\n<span style=\"font-family: var(--ui-font-family-primary, var(--ui-font-family-helvetica));\">В сочетании с технологией трехмерного лазерного сканирования и высокоточным динамическим отслеживанием с помощью оптического трекера E-Track она обеспечивает быстрый и точный сбор данных.</span>\r\n\r\n&nbsp;\r\n\r\n<span style=\"font-family: var(--ui-font-family-primary, var(--ui-font-family-helvetica));\">Система комплектуется портативной координатно-измерительной машиной i-Probe (беспроводной КИМ) с повторяемостью до 0.025 мм в точке. (Опционально)</span>",
