# Для локального запуска. В облачном окружении Claude Code лучше сетевые секреты (см. README → Доступы).
# Яндекс.Вебмастер + Яндекс.Метрика (OAuth, права webmaster:hostinfo и metrika:read)
YANDEX_OAUTH_TOKEN=
# Номер счётчика уже указан в config/project.yaml; переменная его переопределяет
YANDEX_METRIKA_COUNTER=

# Yandex Cloud Search API: Wordstat + выдача (роль search-api.webSearch.user)
YANDEX_CLOUD_API_KEY=
# Или yandex.cloud_folder_id в config/project.yaml
YANDEX_CLOUD_FOLDER_ID=

# Альтернатива для Wordstat: API Wordstat (доступ через поддержку Директа)
WORDSTAT_OAUTH_TOKEN=
